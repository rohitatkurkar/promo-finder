# Copy this file to .env and add your key. Never commit .env.
#
# Any provider with an OpenAI compatible API works. Change these lines to swap models.
# Checked against official pages on 2026-11-05. Limits and prices can change, so
# confirm them in your provider's console. `python run.py check-provider` tests your
# key and model names without sending any screenplay text.

# Shared settings. A role setting below overrides these.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=

# The finder reads episodes. The evaluator runs the blind tests. Using two different
# models stops a model from approving its own picks.
FINDER_MODEL=openai/gpt-oss-120b
EVALUATOR_MODEL=qwen/qwen3.8-27b

# Optional: give each role its own provider or key.
# FINDER_BASE_URL=
# FINDER_API_KEY=
# EVALUATOR_BASE_URL=
# EVALUATOR_API_KEY=

# Pacing, to stay under per minute limits. Set to 0 to turn off.
LLM_REQUESTS_PER_MINUTE=25
LLM_TOKENS_PER_MINUTE=7000
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=2000

# Optional listed prices per million tokens, used only to report what a run would
# cost on a paid plan. Leave blank if you do not know them.
FINDER_PRICE_INPUT_PER_MILLION=0.15
FINDER_PRICE_OUTPUT_PER_MILLION=0.60
EVALUATOR_PRICE_INPUT_PER_MILLION=
EVALUATOR_PRICE_OUTPUT_PER_MILLION=

# Other examples. Check each provider's data terms before sending confidential scripts.
#   Local Ollama, nothing leaves your machine, no key needed:
#     LLM_BASE_URL=http://localhost:11434/v1
#   Google Gemini (use a paid key for confidential text, see DESIGN_DECISIONS.md):
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
