# Settings for a hosted copy of the app, such as Streamlit Community Cloud.
#
# On Community Cloud: open the app's Settings, then Secrets, and paste these lines with your own values.
# Locally you can instead copy this file to .streamlit/secrets.toml, which Git ignores.
# Never commit real values. The interface reads these on top of any local .env file.

LLM_BASE_URL = "https://api.groq.com/openai/v1"
LLM_API_KEY = "paste-your-groq-key-here"
FINDER_MODEL = "openai/gpt-oss-120b"
EVALUATOR_MODEL = "qwen/qwen3.8-27b"
LLM_REQUESTS_PER_MINUTE = "25"
LLM_TOKENS_PER_MINUTE = "7000"
LLM_TEMPERATURE = "0"
LLM_MAX_OUTPUT_TOKENS = "2000"

# Optional: keep human reviews and finished runs in Supabase so they survive restarts (see README, "Reviews and runs in Supabase").
# Use a SECRET key (Settings > API Keys > secret, starts with sb_secret_), never the publishable one.
# It stays on the server: the app never sends it to the browser. Leave both out to keep reviews in a file.
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_SECRET_KEY = "sb_secret_paste-your-key-here"

# AI assisted mode is open to every visitor, with no episode limit, and spends your free model quota.
# One AI run goes at a time. To switch AI mode off, remove LLM_API_KEY.
